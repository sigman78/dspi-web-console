{
  "name": "dspi-console-web",
  "private": true,
  "license": "MIT",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.app.json && tsc -p tsconfig.node.json",
    "test:layout": "playwright test",
    "lint": "eslint \"{src,test,worker}/**/*.{ts,svelte}\" --max-warnings 0",
    "lint:fix": "eslint \"{src,test,worker}/**/*.{ts,svelte}\" --fix",
    "lint:comments": "uvx unwaffle@0.15.0 check src test scripts --fail-on error",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:worker": "vitest run --config vitest.worker.config.ts",
    "check:worker": "tsc -p worker/tsconfig.json",
    "dev:worker": "wrangler dev --port 8787 --var ALLOWED_ORIGINS:http://localhost:5173",
    "test:hil": "vitest run --config vitest.hil.config.ts",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,svelte}": "eslint --fix"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.4.11",
    "@cloudflare/workers-types": "^5.20261030.1",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@sveltejs/vite-plugin-svelte": "^7.0.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/svelte": "^5.3.1",
    "@tsconfig/svelte": "^5.0.8",
    "@types/node": "^24.12.2",
    "@types/w3c-web-usb": "^1.0.14",
    "@vitest/ui": "^4.1.5",
    "eslint": "^10.3.0",
    "eslint-plugin-svelte": "^3.17.1",
    "globals": "^17.6.0",
    "husky": "^9.1.7",
    "jsdom": "^29.1.0",
    "lint-staged": "^17.0.4",
    "svelte": "^5.55.4",
    "svelte-check": "^4.4.6",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.59.1",
    "usb": "^2.17.0",
    "vite": "^8.0.10",
    "vitest": "^4.1.5",
    "wrangler": "^4.156.0"
  },
  "dependencies": {
    "@fontsource/ibm-plex-sans": "^5.2.8",
    "@fontsource/inter": "^5.2.8",
    "@fontsource/jetbrains-mono": "^5.2.8"
  }
}
